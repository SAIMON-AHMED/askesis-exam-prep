# Environment variables - copy to .env and fill in real values. NEVER commit .env with real secrets.

# Database
DATABASE_URL=postgresql+psycopg://examprep_user:examprep_pass@localhost:5432/examprepai

# Auth
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=5256000
REDIS_URL=redis://localhost:6379/0

# AI
OPENAI_API_KEY=sk-proj-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
AI_SERVICE_API_KEY=sk-proj-your-openai-key-here
AI_SERVICE_MODEL=gpt-4o-mini

# Payments
STRIPE_SECRET_KEY=sk_test_your-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-key-here

# App
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:3000
