# Development environment configuration
# Use this for local development

ENVIRONMENT=development

# ===== Database =====
DB_USER=examprep_user
DB_PASSWORD=examprep_pass
DB_NAME=examprepai
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgresql://examprep_user:examprep_pass@db:5432/examprepai

# ===== Redis Cache =====
REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# ===== API Configuration =====
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# ===== Security (Dev values - change in production!) =====
SECRET_KEY=dev-secret-key-change-in-production-12345678
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===== CORS & Frontend =====
FRONTEND_ORIGIN=http://localhost:3002
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
FRONTEND_PORT=3002
BACKEND_PORT=8001

# ===== OpenAI Configuration =====
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXX
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=https://api.openai.com/v1

# ===== Stripe Configuration (Test keys) =====
STRIPE_PUBLIC_KEY=pk_test_XXXXXXXXXXXXXXXXXXXX
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_test_XXXXXXXXXXXXXXXXXXXX

# ===== Email Configuration (Optional) =====
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=dev@localhost

# ===== Logging =====
LOG_LEVEL=debug

# ===== Feature Flags =====
ENABLE_ADMIN_PANEL=true
ENABLE_ANALYTICS=true
ENABLE_PAYMENTS=false  # Disabled in dev, use test keys
