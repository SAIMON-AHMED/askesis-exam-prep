# Production environment configuration template
# Copy to .env and fill in your actual values

# ===== Environment =====
ENVIRONMENT=production

# ===== Database =====
DB_USER=examprepai_prod
DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
DB_NAME=examprepai_prod
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgresql://examprepai_prod:CHANGE_ME_TO_STRONG_PASSWORD@db:5432/examprepai_prod

# ===== Redis Cache =====
REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# ===== API Configuration =====
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# ===== Security =====
SECRET_KEY=CHANGE_ME_TO_RANDOM_SECRET_KEY_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===== CORS & Frontend =====
FRONTEND_ORIGIN=https://yourdomain.com
NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com
FRONTEND_PORT=3000
BACKEND_PORT=8001

# ===== OpenAI Configuration =====
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXX
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=https://api.openai.com/v1

# ===== Stripe Payment Configuration =====
STRIPE_PUBLIC_KEY=pk_live_XXXXXXXXXXXXXXXXXXXX
STRIPE_SECRET_KEY=sk_live_XXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXX

# ===== Email Configuration (Optional) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@yourdomain.com

# ===== Logging & Monitoring =====
LOG_LEVEL=info
SENTRY_DSN=https://XXXXXXXXXXXXXXXXXXXX@sentry.io/XXXXXXXXXXXXXXXXXXXX

# ===== Database Backup =====
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # 2 AM daily

# ===== Rate Limiting =====
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ===== Feature Flags =====
ENABLE_ADMIN_PANEL=true
ENABLE_ANALYTICS=true
ENABLE_PAYMENTS=true
